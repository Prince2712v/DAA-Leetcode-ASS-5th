class Solution {
    public int[] plusOne(int[] arr) {
        if(arr[arr.length-1] == 0){
            arr[arr.length-1] = 1;
            return arr;
        }
        for(int i =arr.length-1;i>=0;i--){
            if(arr[i]<9){
              arr[i] =  arr[i]+1;
                return arr;
            }
            arr[i] = 0;
        }
        int []ans = new int[arr.length+1];
     ans[0] = 1;
     return ans ;
        
    }
}
