class Solution {
    public void reverse(int[] arr, int lo,int hi){
         while(hi>lo){
            int temp = arr[lo];
            arr[lo] = arr[hi];
            arr[hi] = temp ;
            lo++;
            hi--;
        }

    }
    public void rotate(int[] arr, int k) {

        int lo = 0;
        int hi = arr.length-1;
        k = k%arr.length;
        reverse(arr,0,arr.length-1);
        reverse(arr,0,k-1);
        reverse(arr,k,arr.length-1);
       
