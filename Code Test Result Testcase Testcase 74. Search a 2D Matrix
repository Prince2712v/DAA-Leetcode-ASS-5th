class Solution {
    public boolean searchMatrix(int[][] arr, int target) {
        int row = arr.length ;
        int cols = arr[0].length ;
        int lo = 0 ; int hi = row*cols-1 ;
        while(lo<=hi) {
            int mid = lo +(hi-lo)/2 ;
            int midrows = mid/cols ; int midcols = mid%cols ;
            if(arr[midrows][midcols] == target) return true ;
            else if(arr[midrows][midcols] >target) hi = mid-1;
            else lo = mid+1 ;
        }
        return false ;
    }
}
