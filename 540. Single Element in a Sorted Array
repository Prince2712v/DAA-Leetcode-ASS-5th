class Solution {
    public int singleNonDuplicate(int[] arr) {
        int n=arr.length ;
        if(n==1) return arr[0] ;
        if(arr[0] != arr[1]) return arr[0] ;
        if(arr[n-1] != arr[n-2]) return arr[n-1] ;

        int lo = 0; int hi = n-1 ;
        while(lo<=hi){
            int mid = lo + (hi-lo)/2 ;
            if(arr[mid]!= arr[mid-1] && arr[mid] != arr[mid+1]){
                return arr[mid] ;
            }
            int sc = mid ; int fr = mid ;
            if(arr[mid] == arr[mid-1]) fr = mid-1 ;
            else sc = mid+1 ;
            int leftcount = fr-lo ;
            int rightcount = hi-sc ;
            if(leftcount %2 ==0) lo = sc+1 ;
            else hi = fr-1 ;
        }
        return 2712 ;
    }
}
