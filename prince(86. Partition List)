class Solution {
    public ListNode partition(ListNode head, int x) {
        ListNode dummy1 = new ListNode(-1);
        ListNode temp1 = dummy1;
        ListNode dummy2 = new ListNode(-1);
        ListNode temp2 = dummy2 ;
        ListNode slow = head;
        while(slow!=null){
            if(slow.val<x){
                temp1.next = slow;
                temp1 = slow;
                slow = slow.next;
            }
            else {
                temp2.next = slow;
                temp2 = slow;
                slow = slow.next;
            }
        }
        temp1.next = null;
        temp2.next = null;

        temp1.next = dummy2.next;

        return dummy1.next;
    }
}
